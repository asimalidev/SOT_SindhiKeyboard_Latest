<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg_color"
    tools:context=".sindhikeyboard.ui.fragments.HomeFragment">

    <ScrollView
        android:id="@+id/svCards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/_2sdp"
        app:layout_constraintBottom_toTopOf="@+id/adViewContainer"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvIbadat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_11sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ibadaat_gradient"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/iv_mosque_icon"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:src="@drawable/ic_ibdat"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
                        app:layout_constraintStart_toEndOf="@+id/iv_mosque_icon"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_7sdp"
                            android:fontFamily="@font/lexend_semibold"
                            android:text="@string/ibadaat"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/lexend_medium"
                            android:text="@string/your_daily_dose_of_iman"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_arrow"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_forwardd"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#FFFFFF" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <!-- ROW 1: Themes & Sindhi Stickers -->
            <View
                android:id="@+id/clThemes"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_11sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toStartOf="@+id/clStickers"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cvIbadat" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvThemes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="@string/label_themes"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clThemes"
                app:layout_constraintEnd_toEndOf="@+id/clThemes"
                app:layout_constraintStart_toStartOf="@+id/clThemes"
                app:layout_constraintTop_toTopOf="@+id/clThemes"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivThemes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:src="@drawable/ic_themes"
                app:layout_constraintBottom_toTopOf="@+id/tvThemes"
                app:layout_constraintEnd_toEndOf="@+id/clThemes"
                app:layout_constraintStart_toStartOf="@+id/clThemes"
                android:layout_marginBottom="@dimen/_3sdp"/>

            <View
                android:id="@+id/clStickers"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/clThemes"
                app:layout_constraintTop_toTopOf="@+id/clThemes" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStickers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="@string/sindhi_stickers"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clStickers"
                app:layout_constraintEnd_toEndOf="@+id/clStickers"
                app:layout_constraintStart_toStartOf="@+id/clStickers"
                app:layout_constraintTop_toTopOf="@+id/clStickers"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivStickers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:src="@drawable/ic_sindhi_stickers"
                app:layout_constraintBottom_toTopOf="@+id/tvStickers"
                app:layout_constraintEnd_toEndOf="@+id/clStickers"
                app:layout_constraintStart_toStartOf="@+id/clStickers"
                android:layout_marginBottom="@dimen/_3sdp" />


            <!-- NATIVE AD CONTAINER (Placement preserved) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/nativeAdContainerAd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:visibility="visible"
                app:cardBackgroundColor="#BFBFBF"
                app:cardCornerRadius="@dimen/_5sdp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clThemes">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <include layout="@layout/native_admob_media_left_side_shimmer" />
                </com.facebook.shimmer.ShimmerFrameLayout>
            </androidx.cardview.widget.CardView>


            <!-- ROW 2: Sindhi Editor & Post Gallery (clPostGallery) -->
            <View
                android:id="@+id/clEditor"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toStartOf="@+id/clPostGallery"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/nativeAdContainerAd" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEditor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="@string/sindhi_editor"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clEditor"
                app:layout_constraintEnd_toEndOf="@+id/clEditor"
                app:layout_constraintStart_toStartOf="@+id/clEditor"
                app:layout_constraintTop_toTopOf="@+id/clEditor"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivEditor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                android:src="@drawable/ic_sindhi_editor"
                app:layout_constraintBottom_toTopOf="@+id/tvEditor"
                app:layout_constraintEnd_toEndOf="@+id/clEditor"
                app:layout_constraintStart_toStartOf="@+id/clEditor"
              />

            <View
                android:id="@+id/clPostGallery"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/clEditor"
                app:layout_constraintTop_toTopOf="@+id/clEditor" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDisable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="@string/post_gallery"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clPostGallery"
                app:layout_constraintEnd_toEndOf="@+id/clPostGallery"
                app:layout_constraintStart_toStartOf="@+id/clPostGallery"
                app:layout_constraintTop_toTopOf="@+id/clPostGallery"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivDisable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:src="@drawable/ic_post_gallery"
                app:layout_constraintBottom_toTopOf="@+id/tvDisable"
                app:layout_constraintEnd_toEndOf="@+id/clPostGallery"
                app:layout_constraintStart_toStartOf="@+id/clPostGallery"
                android:layout_marginBottom="@dimen/_3sdp" />


            <View
                android:id="@+id/clDailyStatus"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toStartOf="@+id/clTextTranslation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clEditor" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSindhiStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="@string/label_sindhi_status"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clDailyStatus"
                app:layout_constraintEnd_toEndOf="@+id/clDailyStatus"
                app:layout_constraintStart_toStartOf="@+id/clDailyStatus"
                app:layout_constraintTop_toTopOf="@+id/clDailyStatus"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivDailyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:src="@drawable/ic_status"
                app:layout_constraintBottom_toTopOf="@+id/tvSindhiStatus"
                app:layout_constraintEnd_toEndOf="@+id/clDailyStatus"
                app:layout_constraintStart_toStartOf="@+id/clDailyStatus"
                android:layout_marginBottom="@dimen/_3sdp" />

            <View
                android:id="@+id/clTextTranslation"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/clDailyStatus"
                app:layout_constraintTop_toTopOf="@+id/clDailyStatus" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTextResize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="@string/label_translation"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clTextTranslation"
                app:layout_constraintEnd_toEndOf="@+id/clTextTranslation"
                app:layout_constraintStart_toStartOf="@+id/clTextTranslation"
                app:layout_constraintTop_toTopOf="@+id/clTextTranslation"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:src="@drawable/ic_translation"
                app:layout_constraintBottom_toTopOf="@+id/tvTextResize"
                app:layout_constraintEnd_toEndOf="@+id/clTextTranslation"
                app:layout_constraintStart_toStartOf="@+id/clTextTranslation"
                android:layout_marginBottom="@dimen/_3sdp" />



            <View
                android:id="@+id/clTextReverse"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/clStylishText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clDailyStatus" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTextReverse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="@string/label_text_reverse"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clTextReverse"
                app:layout_constraintEnd_toEndOf="@+id/clTextReverse"
                app:layout_constraintStart_toStartOf="@+id/clTextReverse"
                app:layout_constraintTop_toTopOf="@+id/clTextReverse"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivTextReverse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:src="@drawable/ic_text_reverse"
                app:layout_constraintBottom_toTopOf="@+id/tvTextReverse"
                app:layout_constraintEnd_toEndOf="@+id/clTextReverse"
                app:layout_constraintStart_toStartOf="@+id/clTextReverse"
                android:layout_marginBottom="@dimen/_3sdp" />

            <View
                android:id="@+id/clStylishText"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/clTextReverse"
                app:layout_constraintTop_toTopOf="@+id/clTextReverse" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvStylish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="Stylish Text"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clStylishText"
                app:layout_constraintEnd_toEndOf="@+id/clStylishText"
                app:layout_constraintStart_toStartOf="@+id/clStylishText"
                app:layout_constraintTop_toTopOf="@+id/clStylishText"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivTextstylish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:src="@drawable/ic_stylish_txt"
                app:layout_constraintBottom_toTopOf="@+id/tvStylish"
                app:layout_constraintEnd_toEndOf="@+id/clStylishText"
                app:layout_constraintStart_toStartOf="@+id/clStylishText"
                android:layout_marginBottom="@dimen/_3sdp" />

            <View
                android:id="@+id/clDictionary"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDictionary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivDictionary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:background="@color/black"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/adViewContainer" />

    <FrameLayout
        android:id="@+id/adViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ad_bg_banner"
        android:padding="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/svCards">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayoutBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/size_native_small_shimmer" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>