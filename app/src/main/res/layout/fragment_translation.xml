<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/home_bg_color"
    tools:context=".sindhikeyboard.ui.fragments.dictionary.TranslationFragment">

    <ScrollView
        android:id="@+id/svCards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/adViewContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/home_bg_color">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvConversationBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clConversation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ibadaat_gradient"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivConversation"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:src="@drawable/ic_conversation_new"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:gravity="center|start"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/iv_arrow_conv"
                        app:layout_constraintStart_toEndOf="@+id/ivConversation"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvConversation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lexend_semibold"
                            android:text="@string/label_conversation"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:fontFamily="@font/lexend_medium"
                            android:text="Talk naturally Get instant answers"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_arrow_conv"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_forwardd"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#FFFFFF" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <View
                android:id="@+id/clTextTranslator"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toStartOf="@+id/clSpeechToText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cvConversationBanner" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTextTranslator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="@string/label_text_translator"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clTextTranslator"
                app:layout_constraintEnd_toEndOf="@+id/clTextTranslator"
                app:layout_constraintStart_toStartOf="@+id/clTextTranslator"
                app:layout_constraintTop_toTopOf="@+id/clTextTranslator"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivTextTranslator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:layout_marginBottom="@dimen/_3sdp"
                android:src="@drawable/ic_translation_new"
                app:layout_constraintBottom_toTopOf="@+id/tvTextTranslator"
                app:layout_constraintEnd_toEndOf="@+id/clTextTranslator"
                app:layout_constraintStart_toStartOf="@+id/clTextTranslator"
                 />

            <View
                android:id="@+id/clSpeechToText"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/clTextTranslator"
                app:layout_constraintTop_toTopOf="@+id/clTextTranslator" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSpeechToText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="@string/label_speechTotext"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clSpeechToText"
                app:layout_constraintEnd_toEndOf="@+id/clSpeechToText"
                app:layout_constraintStart_toStartOf="@+id/clSpeechToText"
                app:layout_constraintTop_toTopOf="@+id/clSpeechToText"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivSpeechToText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:src="@drawable/ic_speech_to_text"
                app:layout_constraintBottom_toTopOf="@+id/tvSpeechToText"
                app:layout_constraintEnd_toEndOf="@+id/clSpeechToText"
                app:layout_constraintStart_toStartOf="@+id/clSpeechToText"
                android:layout_marginBottom="@dimen/_3sdp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/nativeAdContainerAd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_3sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:visibility="visible"
                app:cardBackgroundColor="@color/native_ad_background"
                app:cardCornerRadius="@dimen/_5sdp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clTextTranslator">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <include layout="@layout/native_admob_media_left_side_shimmer" />
                </com.facebook.shimmer.ShimmerFrameLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:id="@+id/clHistroy"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toStartOf="@+id/clImageTranslation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/nativeAdContainerAd" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="@string/label_history"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clHistroy"
                app:layout_constraintEnd_toEndOf="@+id/clHistroy"
                app:layout_constraintStart_toStartOf="@+id/clHistroy"
                app:layout_constraintTop_toTopOf="@+id/clHistroy"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:src="@drawable/ic_history_new"
                app:layout_constraintBottom_toTopOf="@+id/tvHistory"
                app:layout_constraintEnd_toEndOf="@+id/clHistroy"
                app:layout_constraintStart_toStartOf="@+id/clHistroy"
                android:layout_marginBottom="@dimen/_3sdp" />

            <View
                android:id="@+id/clImageTranslation"
                android:layout_width="0dp"
                android:layout_height="@dimen/_70sdp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@drawable/buttons_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/clHistroy"
                app:layout_constraintTop_toTopOf="@+id/clHistroy" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvImageTranslation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/_10sdp"
                android:clickable="false"
                android:elevation="@dimen/_11sdp"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="Image Translation"
                android:textColor="@color/app_text"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold"
                app:fontFamily="@font/lexend"
                app:layout_constraintBottom_toBottomOf="@+id/clImageTranslation"
                app:layout_constraintEnd_toEndOf="@+id/clImageTranslation"
                app:layout_constraintStart_toStartOf="@+id/clImageTranslation"
                app:layout_constraintTop_toTopOf="@+id/clImageTranslation"
                app:layout_constraintVertical_bias="1" />

            <ImageView
                android:id="@+id/ivImageTranslation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="@dimen/_11sdp"
                android:src="@drawable/ic_image_translation"
                app:layout_constraintBottom_toTopOf="@+id/tvImageTranslation"
                app:layout_constraintEnd_toEndOf="@+id/clImageTranslation"
                app:layout_constraintStart_toStartOf="@+id/clImageTranslation"
                android:layout_marginBottom="@dimen/_3sdp" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/adViewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ad_bg_banner"
        android:padding="@dimen/_2sdp"
        android:layout_marginTop="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintBottom_toBottomOf="parent">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayoutBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/size_native_small_shimmer" />
        </com.facebook.shimmer.ShimmerFrameLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>