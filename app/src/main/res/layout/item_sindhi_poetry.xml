<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_8sdp"
    android:layout_marginVertical="@dimen/_8sdp"
    android:background="@drawable/bg_status"
    android:padding="@dimen/_12sdp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnSeeMore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v1Status"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1sdp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/btnSeeMore" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEditPost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_pill_red"
        android:text="Edit Post"
        android:textAllCaps="false"
        android:fontFamily="@font/lexend_medium"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:drawableStart="@drawable/ic_edit_post"
        android:drawablePadding="6dp"
        app:drawableTint="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/txtQuotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_nastaliq"
        android:gravity="center"
        android:layout_marginTop="@dimen/_6sdp"
        android:lineSpacingExtra="@dimen/_8sdp"
        android:paddingHorizontal="@dimen/_5sdp"
        android:text="محبت زندگی کے فیصلوں سے لڑ نہیں سکتی!\nکسی کو کھونا پڑتا ہے اور کسی کا ہونا پڑتا ہے!"
        android:textColor="@color/black"
        android:textSize="@dimen/_12ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnEditPost" />

    <LinearLayout
        android:id="@+id/copyShareWhatsapp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtQuotes">

        <ImageView
            android:id="@+id/btnWhatsapp"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:background="@drawable/bg_circle_btn"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/ic_whatsapp" />

        <ImageView
            android:id="@+id/btnCopy"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginStart="@dimen/_20sdp"
            android:background="@drawable/bg_circle_btn"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_copy" />

        <ImageView
            android:id="@+id/btnShare"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_marginStart="@dimen/_20sdp"
            android:background="@drawable/bg_circle_btn"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/ic_sharee" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>