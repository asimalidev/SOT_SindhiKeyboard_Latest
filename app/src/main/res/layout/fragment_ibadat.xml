<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://tools.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#F4F4F4"
tools:context=".sindhikeyboard.ui.fragments.ibadat.IbadatFragment">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/clHeaderStickerDetails"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_50sdp"
    android:background="@drawable/bg_header_blue"
    android:backgroundTint="@color/white"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <ImageView
        android:id="@+id/ivBackPress"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:padding="@dimen/_5sdp"
        android:src="@drawable/back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/txtUrduKeyboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtUrduKeyboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:drawablePadding="@dimen/_10sdp"
        android:drawableTint="@color/White"
        android:fontFamily="@font/lexend_medium"
        android:gravity="start|center_vertical"
        android:paddingStart="@dimen/_5sdp"
        android:text="Hadith Library"
        android:textColor="@color/black"
        android:textSize="@dimen/_15ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivBackPress"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<com.google.android.material.tabs.TabLayout
    android:id="@+id/tabLayout"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    app:tabMode="scrollable"
    app:tabIndicatorHeight="0dp"
    android:background="#F4F4F4"
    android:layout_marginHorizontal="@dimen/_5sdp"
    android:layout_marginVertical="10dp"
    app:tabPaddingStart="10dp"
    app:tabPaddingEnd="10dp"
    app:tabTextAppearance="@style/CustomTabTextStyle"
    app:tabRippleColor="@android:color/transparent"
    app:tabSelectedTextColor="@android:color/white"
    app:tabTextColor="@android:color/black"
    app:tabBackground="@drawable/tab_background_selector"
    app:layout_constraintTop_toBottomOf="@id/clHeaderStickerDetails" />

<androidx.viewpager2.widget.ViewPager2
    android:id="@+id/viewPager"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="@dimen/_5sdp"
    app:layout_constraintTop_toBottomOf="@id/tabLayout"
    app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>